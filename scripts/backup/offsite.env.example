# Server-only runtime contract for offsite-backup.sh.  Store the real file at
# /srv/backups/offsite/offsite.env with mode 0600; it contains no credentials.
#
# The accompanying rclone.conf is server-only, mode 0600, and contains the bucket-scoped
# R2 Object Read & Write credential.  Do not commit either real file.
OFFSITE_RCLONE_CONFIG=/srv/backups/offsite/rclone.conf
OFFSITE_RCLONE_ROOT=backup-r2:REPLACE_WITH_PRIVATE_DATABASE_BACKUP_BUCKET
