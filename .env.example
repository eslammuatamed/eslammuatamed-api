# Copy to .env and adjust per environment. The process refuses to boot on an invalid
# environment (doc 07 §3). The production domain is deferred (D23-8): all hosts live
# here, never in code. Values below are development defaults — every secret MUST be
# replaced outside local development.

NODE_ENV=development
PORT=3001

# PostgreSQL 16 (doc 09). Native local Postgres: passwordless `eslammuatamed` role.
# This URL connects over TCP with no password: Ubuntu's default pg_hba.conf demands
# scram-sha-256 for 127.0.0.1, which a passwordless role cannot satisfy, so the first
# `prisma migrate deploy` / `db:seed` fails until a scoped loopback `trust` line is added.
# See runbooks/setup.md §A1 (local) / §B2 (server) in ../eslammuatamed-docs for the line.
DATABASE_URL=postgresql://eslammuatamed@localhost:5432/eslammuatamed_dev

# Exact public-site origin allowed by CORS (doc 19 §2) — never "*"
CORS_ORIGIN=http://localhost:3000

# Absolute origin of the rendered Web app the signed preview link points at (D10-11): the API signs,
# the Web renders. Dedicated config — NOT derived from CORS_ORIGIN. Required in production (no default).
PUBLIC_WEB_URL=http://localhost:3000

# Auth (doc 19 §2). Separate secrets per concern; rotate on suspicion.
JWT_ACCESS_SECRET=dev-only-access-secret-minimum-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_PEPPER=dev-only-refresh-pepper-change-me
PREVIEW_TOKEN_SECRET=dev-only-preview-secret-change-me

# Cookie scope for the refresh token. Empty = host-only (correct for localhost).
# Production: the shared registrable domain, e.g. ".example.com" (D19-3).
COOKIE_DOMAIN=

# Seeded OWNER account (doc 09 §6). Change the password immediately in production.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-minimum-12-chars

# Media storage (doc 07 §6): "local" in development, "s3"/R2 in production (D23-3/D23-15).
# PUBLIC_MEDIA_URL is required for both drivers; STORAGE_LOCAL_DIR only for local; the S3_* group
# only when STORAGE_DRIVER=s3. In production PUBLIC_MEDIA_URL must be an absolute https URL.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
PUBLIC_MEDIA_URL=http://localhost:3001/media

# Cloudflare R2 (S3-compatible) — required only when STORAGE_DRIVER=s3 (doc 23 §1). PLACEHOLDERS
# ONLY: real bucket-scoped credentials live in the server environment, never in the repo (doc 19 §7).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=eslammuatamed-media
S3_ACCESS_KEY_ID=replace-with-r2-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
S3_REGION=auto

# ── Outbound SMTP (contact notifications) ────────────────────────────────────────────────────
# OPTIONAL as a unit and OFF by default: an environment that omits this group behaves exactly as
# it did before mail existed. Set SMTP_ENABLED=true and every field below becomes required — a
# missing one aborts boot rather than failing silently at the first submission.
#
# NOTE: these names were introduced by the API; if the server environment already carries SMTP
# settings under different names, reconcile the two before enabling (see src/modules/mail/README.md).
# Real credentials live in the server environment, never in the repo (doc 19 §7).
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
# 465 with SMTP_SECURE=true (implicit TLS), or 587 with SMTP_SECURE=false (STARTTLS).
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Envelope sender — a bare address, no display name.
SMTP_FROM=no-reply@eslammuatamed.com
# Owner notification destination. Deliberately separate from SiteSettings.contactEmail, which is
# published content: a content edit must not be able to redirect operational mail (doc 10).
CONTACT_NOTIFICATION_TO=owner@eslammuatamed.com
