{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": [
    "<rootDir>/utils/e2e-setup.ts"
  ],
  "globalTeardown": "<rootDir>/utils/e2e-teardown.ts",
  "globalSetup": "<rootDir>/utils/e2e-global-setup.ts"
}
