// Database schema — doc 09. Prisma models PascalCase / fields camelCase; database
// identifiers snake_case via @map/@@map (D09-1). UUIDv7 primary keys (D09-2). Every
// table carries createdAt/updatedAt (NFR-008). The FTS tsvector column + GIN index on
// article_translations is added in a handwritten migration (D09-6) — Prisma cannot
// express generated columns.

// The generated client is TypeScript source compiled by our own build, not a
// package inside node_modules (Prisma 7). It is gitignored and regenerated by
// `npm run db:generate`. `moduleFormat = "cjs"` because this project is CommonJS.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Emit extensionless relative imports inside the generated client. The default
  // (".js") is an ESM convention that Jest's resolver cannot follow back to the
  // .ts source; extensionless matches how the rest of this repository imports.
  importFileExtension = ""
}

// Prisma 7 takes the CLI's connection URL from prisma.config.ts, not from here.
datasource db {
  provider = "postgresql"
}

// ===== Enums — code-coupled, therefore true enums (contrast D09-5) =====

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// Public skills taxonomy. Declaration order IS display order: `SkillsService.compareSkills`
// ranks groups by `Object.values(SkillGroup).indexOf(...)`, and Web renders them in that
// sequence on both the homepage and the résumé. Renaming a value therefore keeps its position;
// appending one puts it last.
enum SkillGroup {
  LANGUAGE
  FRONTEND
  BACKEND
  DELIVERY
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
}

// Media asset kind + rendition format (D09-12 / D09-11). PDF is resume-only (D02-7).
enum MediaKind {
  IMAGE
  PDF
}

enum MediaVariantFormat {
  WEBP
  AVIF
}

// ===== Localization reference table (D09-5) — adding a language is an INSERT =====

model Locale {
  code       String  @id // 'en', 'ar'
  name       String
  nativeName String  @map("native_name")
  dir        String // 'ltr' | 'rtl' — drives RTL handling as data
  isEnabled  Boolean @default(true) @map("is_enabled")
  order      Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  articleTranslations      ArticleTranslation[]
  categoryTranslations     CategoryTranslation[]
  tagTranslations          TagTranslation[]
  projectTranslations      ProjectTranslation[]
  galleryItemTranslations  ProjectGalleryItemTranslation[]
  experienceTranslations   ExperienceTranslation[]
  skillTranslations        SkillTranslation[]
  testimonialTranslations  TestimonialTranslation[]
  siteSettingsTranslations SiteSettingsTranslation[]
  mediaAssetAlts           MediaAssetAlt[]
  pageSeos                 PageSeo[]
  slugRedirects            SlugRedirect[]

  @@map("locales")
}

// ===== Identity & sessions (doc 19) =====

model User {
  id           String  @id @default(uuid(7))
  email        String  @unique
  passwordHash String  @map("password_hash") // argon2id (D19-1)
  roleId       String  @map("role_id") // dynamic RBAC (D09-7); authorization resolved per request (D19-8)
  isActive     Boolean @default(true) @map("is_active") // deactivation blocks login + all grants (doc 10 §5)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role           Role                  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens  RefreshToken[]
  // Replies this operator initiated (D09-23). Restricts on delete — attribution is not erasable.
  contactReplies ContactMessageReply[]

  @@index([roleId])
  @@map("users")
}

// Dynamic RBAC (D09-7, FR-DSH-090): roles are operator-created data; the permission catalog is
// code (src/modules/access-control/permissions.ts). The seeded OWNER system role is undeletable
// and uneditable and holds the single reserved '*' wildcard grant (D19-8).
model Role {
  id          String  @id @default(uuid(7))
  name        String  @unique
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

// One grant per row (D09-7). `permission` is a code-defined catalog key (e.g. 'articles.read')
// or the reserved '*' wildcard (D19-8). Grants are data; the catalog is code.
model RolePermission {
  id         String @id @default(uuid(7))
  roleId     String @map("role_id")
  permission String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([roleId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") // SHA-256(token + pepper) — doc 19 §2
  familyId  String    @map("family_id") // rotation lineage; reuse revokes the family (D19-2)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ===== Articles + taxonomy =====

model Article {
  id           String        @id @default(uuid(7))
  status       ContentStatus @default(DRAFT)
  publishAt    DateTime?     @map("publish_at")
  categoryId   String        @map("category_id")
  coverImageId String?       @map("cover_image_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  coverImage   MediaAsset?          @relation("ArticleCover", fields: [coverImageId], references: [id], onDelete: Restrict)
  translations ArticleTranslation[]
  tags         ArticleTag[]

  @@index([status, publishAt]) // public listing + scheduler query (D07-3, D09-5)
  @@index([categoryId])
  @@map("articles")
}

model ArticleTranslation {
  id              String  @id @default(uuid(7))
  articleId       String  @map("article_id")
  locale          String
  title           String
  slug            String
  excerpt         String
  body            String // opaque Markdown (D01-5)
  readingTimeMin  Int     @map("reading_time_min") // computed on write
  metaTitle       String? @map("meta_title") // embedded SEO (D09-4)
  metaDescription String? @map("meta_description")
  ogImageId       String? @map("og_image_id")
  canonicalUrl    String? @map("canonical_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  article   Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  localeRef Locale      @relation(fields: [locale], references: [code])
  ogImage   MediaAsset? @relation("ArticleTranslationOg", fields: [ogImageId], references: [id], onDelete: Restrict)

  // Raw-SQL FTS column (D09-6): PostgreSQL `GENERATED ALWAYS AS (...) STORED`, created by the
  // init migration. Prisma cannot express a stored generated column, so it is declared as an
  // Unsupported tsvector with the generation expression mirrored as a `dbgenerated` default.
  // This representation is deliberately imprecise but empirically drift-free on the current
  // 7.9.1 (D16-13): without it, `migrate dev` emits DROP INDEX + DROP COLUMN on every run.
  // The column and index are protected by the migration guard — see prisma/README.md.
  searchVector Unsupported("tsvector")? @default(dbgenerated("to_tsvector(\nCASE\n    WHEN (locale = 'ar'::text) THEN 'simple'::regconfig\n    ELSE 'english'::regconfig\nEND, ((COALESCE(title, ''::text) || ' '::text) || COALESCE(excerpt, ''::text)))")) @map("search_vector")

  @@unique([articleId, locale])
  @@unique([locale, slug]) // slugs unique per locale (D04-2); doubles as lookup index
  @@index([searchVector], type: Gin)
  @@map("article_translations")
}

model Category {
  id String @id @default(uuid(7))

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations CategoryTranslation[]
  articles     Article[]

  @@map("categories")
}

model CategoryTranslation {
  id          String  @id @default(uuid(7))
  categoryId  String  @map("category_id")
  locale      String
  name        String
  slug        String
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  localeRef Locale   @relation(fields: [locale], references: [code])

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@map("category_translations")
}

model Tag {
  id String @id @default(uuid(7))

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations TagTranslation[]
  articles     ArticleTag[]

  @@map("tags")
}

model TagTranslation {
  id     String @id @default(uuid(7))
  tagId  String @map("tag_id")
  locale String
  name   String
  slug   String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tag       Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  localeRef Locale @relation(fields: [locale], references: [code])

  @@unique([tagId, locale])
  @@unique([locale, slug])
  @@map("tag_translations")
}

model ArticleTag {
  articleId String @map("article_id")
  tagId     String @map("tag_id")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

// ===== Projects (schema-complete for feature 002+; no M1 module) =====

model Project {
  id          String  @id @default(uuid(7))
  featured    Boolean @default(false)
  isPublished Boolean @default(false) @map("is_published")
  order       Int     @default(0)
  liveUrl     String? @map("live_url")
  repoUrl     String? @map("repo_url")
  year        Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations ProjectTranslation[]
  gallery      ProjectGalleryItem[]
  technologies ProjectTechnology[]

  @@index([featured, order])
  @@map("projects")
}

model ProjectTranslation {
  id              String  @id @default(uuid(7))
  projectId       String  @map("project_id")
  locale          String
  title           String
  slug            String
  summary         String
  overview        String // structured case-study sections, each Markdown (FR-CNT-020)
  businessProblem String  @map("business_problem")
  solution        String
  role            String
  architecture    String
  challenges      String
  features        String
  lessonsLearned  String  @map("lessons_learned")
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  ogImageId       String? @map("og_image_id")
  canonicalUrl    String? @map("canonical_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  localeRef Locale      @relation(fields: [locale], references: [code])
  ogImage   MediaAsset? @relation("ProjectTranslationOg", fields: [ogImageId], references: [id], onDelete: Restrict)

  @@unique([projectId, locale])
  @@unique([locale, slug])
  @@map("project_translations")
}

model ProjectGalleryItem {
  id           String @id @default(uuid(7))
  projectId    String @map("project_id")
  mediaAssetId String @map("media_asset_id")
  order        Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project      Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset                      @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  translations ProjectGalleryItemTranslation[]

  @@index([projectId])
  @@map("project_gallery_items")
}

model ProjectGalleryItemTranslation {
  id            String  @id @default(uuid(7))
  galleryItemId String  @map("gallery_item_id")
  locale        String
  caption       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  galleryItem ProjectGalleryItem @relation(fields: [galleryItemId], references: [id], onDelete: Cascade)
  localeRef   Locale             @relation(fields: [locale], references: [code])

  @@unique([galleryItemId, locale])
  @@map("project_gallery_item_translations")
}

model ProjectTechnology {
  projectId String @map("project_id")
  skillId   String @map("skill_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([projectId, skillId])
  @@index([skillId])
  @@map("project_technologies")
}

// Experience ↔ Skill join (D09-17) — mirrors ProjectTechnology exactly so one canonical,
// translatable label source serves both surfaces. No order column: presentation order derives
// from Skill.order, keeping Experience and Projects consistent. Cascade from Experience;
// Restrict from Skill so a referenced skill cannot be deleted out from under an entry.
model ExperienceTechnology {
  experienceId String @map("experience_id")
  skillId      String @map("skill_id")

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([experienceId, skillId])
  @@index([skillId])
  @@map("experience_technologies")
}

// ===== Skills, experiences, testimonials (schema-complete; no M1 module) =====

model Skill {
  id         String     @id @default(uuid(7))
  // The stable public identity. Lowercase kebab-case, locale-independent, and unchanged when a
  // localized label changes — public filter URLs are `/projects?technology=<slug>`, so deriving
  // the identifier from a translated label would make the same filter a different URL per locale
  // and break every shared link the moment copy is edited. Labels stay presentation-only.
  slug       String     @unique
  group      SkillGroup
  order      Int        @default(0)
  brandColor String?    @map("brand_color")
  // Visibility, not deletion. A skill that leaves the public taxonomy is still referenced by
  // projects and experiences, so it is hidden rather than removed: the public listing filters
  // on this flag while the admin listing and every relation stay intact.
  isPublic   Boolean    @default(true) @map("is_public")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations    SkillTranslation[]
  projectLinks    ProjectTechnology[]
  experienceLinks ExperienceTechnology[]

  @@map("skills")
}

model SkillTranslation {
  id      String @id @default(uuid(7))
  skillId String @map("skill_id")
  locale  String
  label   String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  skill     Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  localeRef Locale @relation(fields: [locale], references: [code])

  @@unique([skillId, locale])
  @@map("skill_translations")
}

model Experience {
  id             String         @id @default(uuid(7))
  startDate      DateTime       @map("start_date")
  endDate        DateTime?      @map("end_date")
  isCurrent      Boolean        @default(false) @map("is_current")
  employmentType EmploymentType @map("employment_type")
  order          Int            @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations ExperienceTranslation[]
  technologies ExperienceTechnology[]

  @@map("experiences")
}

model ExperienceTranslation {
  id           String @id @default(uuid(7))
  experienceId String @map("experience_id")
  locale       String
  role         String
  company      String
  location     String
  impact       String // Markdown list

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  localeRef  Locale     @relation(fields: [locale], references: [code])

  @@unique([experienceId, locale])
  @@map("experience_translations")
}

model Testimonial {
  id        String  @id @default(uuid(7))
  avatarId  String? @map("avatar_id")
  order     Int     @default(0)
  isVisible Boolean @default(true) @map("is_visible")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  avatar       MediaAsset?              @relation("TestimonialAvatar", fields: [avatarId], references: [id], onDelete: Restrict)
  translations TestimonialTranslation[]

  @@map("testimonials")
}

model TestimonialTranslation {
  id            String @id @default(uuid(7))
  testimonialId String @map("testimonial_id")
  locale        String
  quote         String
  authorName    String @map("author_name")
  authorRole    String @map("author_role")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  testimonial Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)
  localeRef   Locale      @relation(fields: [locale], references: [code])

  @@unique([testimonialId, locale])
  @@map("testimonial_translations")
}

// ===== Media, SEO, redirects, contact, settings =====

model MediaAsset {
  id               String    @id @default(uuid(7))
  kind             MediaKind
  storageKey       String    @unique @map("storage_key")
  originalFilename String    @map("original_filename")
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  contentHash      String    @unique @map("content_hash")
  // IMAGE: base fields describe the sanitized WebP-q90 master (the raw upload is never persisted,
  // D07-6). PDF: base fields describe the PDF object. The kind↔fields consistency (IMAGE ⇒
  // width/height/blurhash present + image/webp; PDF ⇒ all null + application/pdf) is a DB CHECK.
  width            Int?
  height           Int?
  blurhash         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  alts                MediaAssetAlt[]
  variants            MediaAssetVariant[]
  articleCovers       Article[]            @relation("ArticleCover")
  articleOgImages     ArticleTranslation[] @relation("ArticleTranslationOg")
  projectOgImages     ProjectTranslation[] @relation("ProjectTranslationOg")
  galleryItems        ProjectGalleryItem[]
  testimonialAvatars  Testimonial[]        @relation("TestimonialAvatar")
  resumeForSettings   SiteSettings[]       @relation("SettingsResume")
  portraitForSettings SiteSettings[]       @relation("SettingsPortrait")
  pageSeoOgImages     PageSeo[]            @relation("PageSeoOg")

  @@map("media_assets")
}

model MediaAssetAlt {
  id           String @id @default(uuid(7))
  mediaAssetId String @map("media_asset_id")
  locale       String
  alt          String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  localeRef  Locale     @relation(fields: [locale], references: [code])

  @@unique([mediaAssetId, locale])
  @@map("media_asset_alts")
}

// Generated image renditions of a MediaAsset (D09-11, doc 20 §4). IMAGE assets only —
// PDFs have no variants (a service invariant). Deleted with the parent asset (CASCADE).
model MediaAssetVariant {
  id           String             @id @default(uuid(7))
  mediaAssetId String             @map("media_asset_id")
  format       MediaVariantFormat
  width        Int
  height       Int
  storageKey   String             @unique @map("storage_key")
  sizeBytes    Int                @map("size_bytes")
  // Rendition stayed above its doc 20 §4 width×format budget at the quality floor (D20-6):
  // admin/ops-searchable, delivery-non-blocking, never exposed in the public descriptor.
  overBudget   Boolean            @default(false) @map("over_budget")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  // mediaAssetId lookups (FK/cascade) are served by the composite unique's leftmost prefix.
  @@unique([mediaAssetId, format, width])
  @@map("media_asset_variants")
}

model PageSeo {
  id              String  @id @default(uuid(7))
  pageKey         String  @map("page_key")
  locale          String
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  ogImageId       String? @map("og_image_id")
  canonicalUrl    String? @map("canonical_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  localeRef Locale      @relation(fields: [locale], references: [code])
  ogImage   MediaAsset? @relation("PageSeoOg", fields: [ogImageId], references: [id], onDelete: Restrict)

  @@unique([pageKey, locale])
  @@map("page_seo")
}

model SlugRedirect {
  id         String @id @default(uuid(7))
  locale     String
  entityType String @map("entity_type")
  fromSlug   String @map("from_slug")
  toSlug     String @map("to_slug")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  localeRef Locale @relation(fields: [locale], references: [code])

  @@unique([locale, entityType, fromSlug])
  @@map("slug_redirects")
}

model ContactMessage {
  id         String    @id @default(uuid(7))
  name       String
  // Visitor contact methods (D09-19, D10-16): BOTH nullable, with at least one non-null enforced by
  // the `contact_messages_contact_method_present` CHECK constraint. Prisma cannot model a CHECK, so
  // the constraint lives in the migration SQL only and is invisible here — doc 09 D09-19 records it
  // for exactly that reason. `phone` is stored in E.164 (leading `+`, digits only), never formatted.
  email      String?
  phone      String?
  subject    String
  body       String
  isRead     Boolean   @default(false) @map("is_read")
  isArchived Boolean   @default(false) @map("is_archived")
  // Archival instant (D09-14): set when isArchived flips true, cleared when it flips back.
  // The basis for the 12-month retention purge (doc 19 §6, D19-10) — see contact-purge.scheduler.ts.
  archivedAt DateTime? @map("archived_at")
  meta       Json      @default("{}") // UA/referrer for spam forensics

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Operator replies to this message (D09-23). Cascades on delete — see ContactMessageReply.
  replies ContactMessageReply[]

  @@index([isArchived, isRead, createdAt])
  @@map("contact_messages")
}

// One logical operator reply to one ContactMessage (D09-23, D02-13). A row is ONE send attempt:
// created PENDING, and moves once — to SENT or FAILED — when a terminal outcome is recorded.
//
// The visitor's name, address and original subject are deliberately NOT copied here. They are read
// through `message`, so there is exactly one answer to "who was this sent to" and no way for a
// stored copy to disagree with the recipient rule. The CASCADE below guarantees the relation is
// always there to read.
model ContactMessageReply {
  id                String                    @id @default(uuid(7))
  contactMessageId  String                    @map("contact_message_id")
  body              String
  status            ContactMessageReplyStatus @default(PENDING)
  // Client-supplied opaque value. Unique PER MESSAGE, not globally (D09-23): a global key space
  // would let a key first used against another message replay into THAT message's reply row.
  idempotencyKey    String                    @map("idempotency_key")
  initiatedByUserId String                    @map("initiated_by_user_id")
  // Transport's own id for the accepted message. Internal — never on a response (D10-21e).
  providerMessageId String?                   @map("provider_message_id")

  createdAt DateTime  @default(now()) @map("created_at")
  sentAt    DateTime? @map("sent_at")
  failedAt  DateTime? @map("failed_at")

  // Cascade, NOT restrict: the 12-month retention purge (D19-10) hard-deletes archived messages,
  // and a restricting reply could veto the deletion of the visitor PII the purge exists to remove.
  message         ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  // Restrict, NOT cascade: a sent reply must not lose the record of who sent it. Currently
  // unexercisable — there is no users.delete capability and no delete route — which is the point:
  // the answer is fixed before a delete path exists rather than after (D09-23).
  initiatedByUser User           @relation(fields: [initiatedByUserId], references: [id], onDelete: Restrict)

  // The duplicate-send invariant. Two concurrent POSTs carrying one key race to INSERT here and
  // exactly one wins; the loser reads the winner's row. This index is also the access path for the
  // history query, whose leading column it already carries — no second index is added for it.
  @@unique([contactMessageId, idempotencyKey])
  @@map("contact_message_replies")
}

// D09-23. Three values, deliberately: the unique index above already establishes which request owns
// an attempt, so a SENDING/claim state would only add a stale row to clean up after a crash.
//
// PENDING is "no terminal outcome was recorded" — which honestly covers both "not sent yet" and the
// hard case where a provider accepted the message and the process died before the status commit.
enum ContactMessageReplyStatus {
  PENDING
  SENT
  FAILED
}

model SiteSettings {
  id               String  @id @default(uuid(7))
  profileLinks     Json    @default("[]") @map("profile_links") // [{ label, url, icon }]
  resumeAssetId    String? @map("resume_asset_id")
  careerStartYear  Int?    @map("career_start_year")
  careerStartMonth Int?    @map("career_start_month")

  // Profile pages (D09-18): About portrait reference + public addresses. Nullable so the
  // migration is additive and administration can be incremental; nullability is a
  // content-readiness gate, not a publication model (doc 02 §9).
  portraitAssetId   String? @map("portrait_asset_id")
  professionalEmail String? @map("professional_email")
  contactEmail      String? @map("contact_email")
  // Public owner contact numbers (D09-19, D10-16), E.164. INDEPENDENTLY nullable and never derived
  // from one another: not every telephone number has WhatsApp, so a consumer that inferred one from
  // the other would publish a link that silently fails. They happen to hold the same value in the
  // owner seed; that coincidence is deliberately not modelled as one column.
  contactPhone      String? @map("contact_phone")
  whatsappPhone     String? @map("whatsapp_phone")

  // Global head/tag fields (FR-DSH-052) — verification, tracking, constrained custom metas.
  googleSiteVerification String? @map("google_site_verification")
  bingSiteVerification   String? @map("bing_site_verification")
  // Tracking is GTM-ONLY (D02-14, owner direction 2026-08-17). There is deliberately no provider
  // column: Google Tag Manager is the single integration point, and the individual vendors it may
  // carry (GA4, Meta Pixel, LinkedIn Insight, conversion tags) are configured INSIDE the GTM
  // container, not here. A provider enum would invite a second per-vendor column for each one added
  // — exactly the shape this decision rejects — and every such column would be a head-tag surface
  // the API has to validate and the budget has to pay for (D20-5).
  //
  // Two fields, one meaning each: `analyticsEnabled` is the kill switch (default OFF, D20-5) and
  // `gtmContainerId` is what to load. A disabled container is never published (see the service).
  analyticsEnabled Boolean @default(false) @map("analytics_enabled")
  gtmContainerId   String? @map("gtm_container_id")
  customMetas      Json    @default("[]") @map("custom_metas") // [{ name, content }] — never scripts

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  resumeAsset   MediaAsset?               @relation("SettingsResume", fields: [resumeAssetId], references: [id], onDelete: Restrict)
  portraitAsset MediaAsset?               @relation("SettingsPortrait", fields: [portraitAssetId], references: [id], onDelete: Restrict)
  translations  SiteSettingsTranslation[]

  @@map("site_settings")
}

model SiteSettingsTranslation {
  id                     String  @id @default(uuid(7))
  siteSettingsId         String  @map("site_settings_id")
  locale                 String
  siteName               String? @map("site_name")
  tagline                String?
  availabilityStatus     String? @map("availability_status") // per-locale (007): localized like tagline, resolved with no cross-locale fallback
  defaultMetaTitle       String? @map("default_meta_title")
  defaultMetaDescription String? @map("default_meta_description")

  // About content (FR-PUB-020, D09-18). aboutBio/engineeringPhilosophy are Markdown source,
  // opaque to the API; currentFocus is plain text. Resolved for the requested locale with no
  // cross-locale fallback (D10-6).
  aboutBio              String? @map("about_bio")
  engineeringPhilosophy String? @map("engineering_philosophy")
  currentFocus          String? @map("current_focus")
  // PER-USAGE alt for the About portrait, and deliberately NOT on `MediaAsset` (D09-22).
  // `MediaAssetAlt` is asset-level DEFAULT metadata for the library and existing consumers; a
  // consuming relation that defines its own localized alt owns the published accessibility text for
  // THAT usage, and per-usage wins. One asset reused in two places can need two different
  // descriptions, so a single global alt cannot be the universal meaning of the asset. It lives
  // here because this row already IS the per-locale About content, so the association is
  // `SiteSettings.portraitAssetId` + this column per locale — no new join table.
  portraitAlt           String? @map("portrait_alt")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  siteSettings SiteSettings @relation(fields: [siteSettingsId], references: [id], onDelete: Cascade)
  localeRef    Locale       @relation(fields: [locale], references: [code])

  @@unique([siteSettingsId, locale])
  @@map("site_settings_translations")
}
